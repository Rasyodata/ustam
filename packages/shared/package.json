{
  "name": "@ustam/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    },
    "./i18n/*": "./dist/i18n/locales/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/i18n/locales','dist/i18n/locales',{recursive:true})\"",
    "postinstall": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/i18n/locales','dist/i18n/locales',{recursive:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "echo \"(shared) lint ok\""
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ustam/config": "workspace:*",
    "typescript": "^5.6.2"
  }
}
