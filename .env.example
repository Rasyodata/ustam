# ============================================================
#  Ustam — Ortam Değişkenleri (örnek). Kopyala: cp .env.example .env
# ============================================================

# --- Genel ---
NODE_ENV=development
DEFAULT_LOCALE=tr
SUPPORTED_LOCALES=tr,en,de,fr,es

# --- API ---
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- PostgreSQL ---
DATABASE_URL="postgresql://ustam:ustam_dev_pw@localhost:5432/ustam?schema=public"

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_ACCESS_SECRET=degistir-bu-cok-gizli-access-anahtari
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=degistir-bu-cok-gizli-refresh-anahtari
JWT_REFRESH_TTL=30d
# argon2 pepper (ek gizli tuz)
PASSWORD_PEPPER=degistir-bu-pepper-degeri

# --- Meilisearch (arama) ---
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=ustam_dev_meili_key

# --- MinIO / S3 (dosya) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ustam
S3_SECRET_KEY=ustam_dev_pw
S3_BUCKET=ustam-media
S3_PUBLIC_URL=http://localhost:9000/ustam-media

# --- E-posta (dev: Mailhog) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Ustam <no-reply@ustam.app>"

# --- SMS sağlayıcı (üretim) — ör. Netgsm / Twilio ---
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=USTAM

# --- Ödeme (escrow) — ör. iyzico / Stripe ---
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
COMMISSION_RATE=0.10

# --- Güvenlik / rate limit ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
OTP_MAX_ATTEMPTS=5
OTP_TTL_SECONDS=300

# --- Web / Admin (Next.js public) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=tr

# --- Mobil (Expo public) ---
EXPO_PUBLIC_API_URL=http://localhost:4000
